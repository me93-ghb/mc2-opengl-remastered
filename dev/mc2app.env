# macos-port: env for the ~/Applications/MC2.app automation wrapper.
# The wrapper sources $MC2_ENV_FILE; point launchd at this file with:
#   launchctl setenv MC2_ENV_FILE /Users/o/Development/mc2-remaster/dev/mc2app.env
export MC2_MACOS_WINDOW=1
export MC2_LOG=1
export MC2_SKIP_INTRO=1
export MC2_RUN_LOG=/tmp/mc2app.log
