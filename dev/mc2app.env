# macos-port: env for the ~/Applications/MC2.app automation wrapper.
# The wrapper sources $MC2_ENV_FILE; point launchd at this file with:
#   launchctl setenv MC2_ENV_FILE /Users/o/Development/mc2-remaster/dev/mc2app.env
export MC2_MACOS_WINDOW=1
export MC2_LOG=1
export MC2_RUN_LOG=/tmp/mc2app.log
# Retail startup: intro movie (msft.mp4) + main menu. MC2_SKIP_INTRO=1 skips
# the movie only, if you want the fast boot back.
# Cheap always-on diagnostics (counters/logs only, no behavior change):
export MC2_REGFLUSH_GUARD2=1
# Under test (behavior change, additive-only): block-level frustum fallback for
# the terrain object cull — candidate fix for buildings/trees popping in/out.
# Remove if it ever causes trouble; verdict pending.
export MC2_BLOCK_FRUSTUM_FALLBACK=1
